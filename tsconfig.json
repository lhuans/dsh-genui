{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Tests and tsdown.config.ts import their own .ts sources by path.
    "allowImportingTsExtensions": true,
    // Node builtins (the web-route half) plus the test globals.
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*", "tests/**/*", "build/**/*", "tsdown.config.ts"]
}
